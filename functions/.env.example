# =============================================================================
# RELATIONSHIT! — Cloud Functions (SERVER-SIDE) environment
# =============================================================================
#
# This is the server-side counterpart to app/.env.example.
#
# CRITICAL DIFFERENCE FROM THE APP ENV FILE
# -----------------------------------------
# Everything in app/.env is prefixed EXPO_PUBLIC_ and is BUNDLED INTO THE
# CLIENT — anyone who installs the app can read those values. Nothing secret
# may ever go there.
#
# The values in THIS file stay on the server. Real secrets belong here (or,
# better, in Secret Manager — see the SECRETS section at the bottom).
#
# SETUP
#   cd functions
#   cp .env.example .env
#   # fill in the values below, then:
#   firebase deploy --only functions
#
# .env is gitignored via the existing "*.local" / add ".env" if needed.
# NEVER commit a filled-in .env.
#
# GOOD NEWS: every variable here is OPTIONAL. The code ships with working
# defaults (shown as the commented-out value). You only need this file if you
# want to override something — most commonly GCLOUD_STORAGE_BUCKET when your
# bucket name doesn't match "<project-id>.appspot.com".
# =============================================================================


# -----------------------------------------------------------------------------
# GOOGLE CLOUD PROJECT
# -----------------------------------------------------------------------------
# GCLOUD_PROJECT is injected automatically by the Firebase Functions runtime.
# Only set it for local emulation or if you must target another project.
# Where: Firebase Console → Project settings → Project ID
# Default: love-actually-game (falls back if the runtime var is absent)
# GCLOUD_PROJECT=love-actually-thegame

# Cloud Storage bucket used for generated Dr. Marcie TTS audio and assets.
# Where: Firebase Console → Storage (the "gs://..." name, without the gs:// prefix)
# NOTE: newer Firebase projects use "<project-id>.firebasestorage.app" rather
# than "<project-id>.appspot.com" — if TTS uploads 404, set this explicitly.
# Default: <GCLOUD_PROJECT>.appspot.com
# GCLOUD_STORAGE_BUCKET=love-actually-thegame.appspot.com


# -----------------------------------------------------------------------------
# GEMINI / VERTEX AI  (the ONLY permitted AI provider)
# -----------------------------------------------------------------------------
# Vertex AI authenticates via the function's service account — there is NO API
# key to paste. You must, however, enable the API once:
#   Google Cloud Console → APIs & Services → Enable "Vertex AI API"
# and grant the runtime service account the "Vertex AI User" role.

# Region the Gemini model is served from. Must be a region where your chosen
# model is available.
# Default: us-central1
# VERTEX_AI_LOCATION=us-central1

# Model id. Spec permits gemini-1.5-pro or gemini-1.5-flash
# (flash is markedly cheaper/faster; pro is higher quality).
# Default: gemini-1.5-pro-001
# GEMINI_MODEL=gemini-1.5-pro-001

# Generation tuning. Raise temperature for more sass/variety, lower it for
# more consistent, predictable responses.
# Defaults: 0.8 / 0.8 / 40 / 4096
# GEMINI_TEMPERATURE=0.8
# GEMINI_TOP_P=0.8
# GEMINI_TOP_K=40
# GEMINI_MAX_OUTPUT_TOKENS=4096


# -----------------------------------------------------------------------------
# GOOGLE CLOUD TEXT-TO-SPEECH  (Dr. Marcie's voice — the ONLY permitted TTS)
# -----------------------------------------------------------------------------
# Also service-account authenticated (no API key). Enable once:
#   Google Cloud Console → APIs & Services → Enable "Cloud Text-to-Speech API"

# The spec pins Dr. Marcie's voice to en-US-Neural2-F. Changing this changes
# her voice — do not alter it without a product decision.
# Defaults: en-US / en-US-Neural2-F
# TTS_LANGUAGE_CODE=en-US
# TTS_VOICE_NAME=en-US-Neural2-F

# How long generated audio URLs remain valid, in milliseconds.
# Default: 900000 (15 minutes)
# TTS_SIGNED_URL_TTL_MS=900000


# =============================================================================
# SECRETS  (do NOT put these in .env — use Secret Manager)
# =============================================================================
# This project currently needs no API-key secrets: Vertex AI and Cloud TTS both
# authenticate through the function's service account, which is why nothing
# above is sensitive.
#
# If you later add a keyed third-party service, bind it as a secret rather than
# adding it to this file:
#
#   firebase functions:secrets:set SOME_API_KEY
#
# and declare it on the function:
#
#   export const fn = functions
#     .runWith({ secrets: ['SOME_API_KEY'] })
#     .https.onCall(...)
#
# Reminder — these remain PROHIBITED by the project's stack mandate:
#   Supabase · Stripe · ElevenLabs · AWS · any non-Firebase backend
# Payments must use native Google Play Billing / Apple IAP, validated in a
# Cloud Function.
# =============================================================================
