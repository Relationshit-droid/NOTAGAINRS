# ---------------------------------------------------------------------------
# Relationshit! backend environment (FastAPI)
# Copy to `.env` for local dev; set these as env vars on Render/Cloud Run.
# Every key below is read by backend code (server.py / security.py / routers).
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
ENVIRONMENT=development          # "production" enables strict checks
PORT=8001
DEBUG=false
LOG_LEVEL=info
WEB_CONCURRENCY=1
APP_VERSION=2.0.0

# --- Firebase (pick ONE credential source) --------------------------------
# 1) Service-account file path (local dev)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# 2) Service-account JSON, base64-encoded (Render/CI)
# FIREBASE_SERVICE_ACCOUNT_BASE64=
#
# 3) Inline service-account fields (Render secret env vars)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_CLIENT_ID=
# FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
#
# 4) Or run without Firestore (CI / local smoke tests only):
# SKIP_FIREBASE=1

# --- Auth & security -------------------------------------------------------
# REQUIRED in production: stable, non-empty, shared by all workers/replicas.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Rate limiting (auth/join endpoints). Defaults: 100 requests / 3600s.
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=3600

# --- CORS (comma-separated list of allowed origins) ------------------------
# CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# --- AI --------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Optional services -----------------------------------------------------
# REDIS_URL=redis://localhost:6379/0        # rate-limit/presence persistence
# SENTRY_DSN=
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://app.posthog.com
# OTEL_EXPORTER_OTLP_ENDPOINT=              # OpenTelemetry traces/metrics
