{
  "cli": {
    "version": ">= 5.9.0",
    "promptToConfigurePushNotifications": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8001",
        "EXPO_PUBLIC_WS_URL": "ws://localhost:8001"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true,
        "buildNumber": "1"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.100:8001",
        "EXPO_PUBLIC_WS_URL": "ws://192.168.1.100:8001"
      },
      "android": {
        "buildType": "apk",
        "versionCode": 1
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://lovetrae-backend-dev-xyz.a.run.app",
        "EXPO_PUBLIC_WS_URL": "wss://lovetrae-backend-dev-xyz.a.run.app"
      },
      "android": {
        "buildType": "apk",
        "versionCode": 1
      },
      "ios": {
        "simulator": false,
        "buildNumber": "1"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://lovetrae-backend-prod-xyz.a.run.app",
        "EXPO_PUBLIC_WS_URL": "wss://lovetrae-backend-prod-xyz.a.run.app"
      },
      "android": {
        "buildType": "app-bundle",
        "versionCode": 1
      },
      "ios": {
        "resourceClass": "m-medium",
        "buildNumber": "1"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account-key.json",
        "track": "production"
      },
      "ios": {
        "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
        "ascApiKeyPath": "./AuthKey.p8",
        "ascApiKeyIssuerId": "YOUR_ISSUER_ID",
        "ascApiKeyId": "YOUR_KEY_ID"
      }
    }
  }
}