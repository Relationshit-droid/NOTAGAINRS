# =============================================================================
# RELATIONSHIT! — environment configuration
#
# Copy this file to `.env` in the same directory (app/.env) and fill in the
# values marked REQUIRED. `.env` is gitignored; never commit real keys.
#
#     cp .env.example .env
#
# Every variable must be prefixed EXPO_PUBLIC_ to be readable by the app at
# runtime. That also means they are embedded in the client bundle, so only
# put publishable keys here. Anything secret (Gemini billing keys, service
# accounts, Google Cloud TTS credentials) belongs in Cloud Functions config,
# never in this file — see the "SERVER-SIDE SECRETS" note at the bottom.
# =============================================================================


# -----------------------------------------------------------------------------
# APP IDENTITY
# -----------------------------------------------------------------------------
EXPO_PUBLIC_APP_NAME=RELATIONSHIT!
EXPO_PUBLIC_APP_VERSION=1.0.0


# -----------------------------------------------------------------------------
# DEMO MODE
#
# true  = run entirely on local fixture data. No Firebase project needed.
#         This is how the preview runs today: dashboard, all six tabs and
#         every game screen work without any credentials.
# false = talk to the real Firebase project configured below. Set this to
#         false only once the REQUIRED Firebase values are filled in.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_DEMO_MODE=true


# -----------------------------------------------------------------------------
# FIREBASE  — REQUIRED when EXPO_PUBLIC_DEMO_MODE=false
#
# Firebase console -> Project settings -> General -> Your apps -> Web app.
# Create the app if there isn't one; the SDK snippet contains every value.
# The app degrades gracefully if these are blank, but auth, Firestore,
# storage and couple linking will be unavailable.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Realtime Database URL. Console -> Realtime Database -> the URL at the top.
# Used for presence, live scores, typing indicators and SOS sessions.
EXPO_PUBLIC_FIREBASE_DATABASE_URL=


# -----------------------------------------------------------------------------
# GOOGLE GEMINI  — OPTIONAL
#
# Dr. Marcie's AI runs server-side in Cloud Functions via Vertex AI, so the
# app does NOT need a Gemini key to work. Leave this blank unless you have
# deliberately added a client-side Gemini call.
#
# The correct place for the real key is Cloud Functions config, so it is
# never shipped in the client bundle. See SERVER-SIDE SECRETS below.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_GEMINI_API_KEY=


# -----------------------------------------------------------------------------
# FEATURE FLAGS  — safe defaults, change only if you want to
# -----------------------------------------------------------------------------
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=false
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
EXPO_PUBLIC_ENABLE_BETA_FEATURES=false


# -----------------------------------------------------------------------------
# OBSERVABILITY  — OPTIONAL, leave blank to disable
# -----------------------------------------------------------------------------
# Sentry: sentry.io -> Project -> Settings -> Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# PostHog: posthog.com -> Project settings -> Project API key
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com


# -----------------------------------------------------------------------------
# THIRD-PARTY CONTENT KEYS  — OPTIONAL
#
# Only needed for specific games. Both are referenced in exactly one module
# each and the app runs fine without them.
# -----------------------------------------------------------------------------
# GIF picker used by the "GIF The Feels" game — developers.giphy.com
EXPO_PUBLIC_GIPHY_API_KEY=

# Map tiles for the "Memory Lane Map" game — account.mapbox.com
EXPO_PUBLIC_MAPBOX_API_KEY=


# -----------------------------------------------------------------------------
# SUPPORT AND LEGAL LINKS  — shown in the profile/settings screens
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPPORT_EMAIL=support@relationshit.app
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://relationshit.app/privacy
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://relationshit.app/terms


# -----------------------------------------------------------------------------
# LEGACY / ADVANCED  — leave blank
#
# The app previously spoke to a REST backend. All data now flows through
# Firestore, so these must stay empty; setting them has no effect.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WS_URL=
EXPO_PUBLIC_ADMIN_BASE_URL=

# Extra salt for locally hashed values. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXPO_PUBLIC_ENCRYPTION_PEPPER=


# =============================================================================
# SERVER-SIDE SECRETS — do NOT put these in this file
#
# Gemini and Google Cloud TTS run inside Cloud Functions, which authenticate
# through the project's own service account. Nothing extra is needed for the
# default setup: enable the APIs and deploy.
#
#   1. Enable the APIs on the Firebase/GCP project:
#        gcloud services enable aiplatform.googleapis.com
#        gcloud services enable texttospeech.googleapis.com
#
#   2. Deploy the functions:
#        cd functions && npm install && npm run deploy
#
#   3. Only if you use an API-key-based Gemini endpoint instead of Vertex AI:
#        firebase functions:config:set gemini.key="YOUR_KEY"
#      That value stays server-side and is never bundled into the app.
# =============================================================================
