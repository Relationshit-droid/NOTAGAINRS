# ---------------------------------------------------------------------------
# Relationshit! Expo app environment
# Copy to `.env` and fill in real values. Expo reads EXPO_PUBLIC_* at build
# time, so any change requires a rebuild (not just a reload). All keys below
# match app/src/lib/env.ts (getEnv reads process.env / Expo Constants extra).
# ---------------------------------------------------------------------------

# App info
EXPO_PUBLIC_APP_NAME=Relationshit
EXPO_PUBLIC_APP_VERSION=2.0.0

# Backend. Use a public URL (never localhost on a physical device).
# Local simulator/emulator can use http://localhost:8001.
EXPO_PUBLIC_API_URL=https://your-backend.onrender.com
EXPO_PUBLIC_WS_URL=wss://your-backend.onrender.com

# Firebase web app config (Firebase console -> Project settings -> Web).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional third-party integrations
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_POSTHOG_API_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# EXPO_PUBLIC_GEMINI_API_KEY=
# EXPO_PUBLIC_ELEVENLABS_API_KEY=
# EXPO_PUBLIC_ELEVENLABS_VOICE_ID_MARCIE=
# EXPO_PUBLIC_GIPHY_API_KEY=
# EXPO_PUBLIC_MAPBOX_API_KEY=
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_ENCRYPTION_PEPPER=
# EXPO_PUBLIC_ADMIN_BASE_URL=

# URLs
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://lovetrae.app/privacy
# EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://lovetrae.app/terms
# EXPO_PUBLIC_SUPPORT_EMAIL=support@lovetrae.app

# Feature flags (defaults shown)
# EXPO_PUBLIC_ENABLE_ANALYTICS=true
# EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true
# EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
# EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true
# EXPO_PUBLIC_ENABLE_BETA_FEATURES=false
